pipeline {
  agent any
  stages {
    stage('Checkout') { steps { checkout scm } }
    stage('Python Setup') { steps { sh 'python3 -m venv venv && . venv/bin/activate && pip install -r requirements.txt' } }
    stage('Unit Tests') { steps { sh '. venv/bin/activate && pytest -q' } }
    stage('Selenium Tests') { steps { sh '. venv/bin/activate && python -m unittest discover selenium' } }
  }
  post { always { junit allowEmptyResults: true, testResults: '**/test-results/*.xml' } }
}
