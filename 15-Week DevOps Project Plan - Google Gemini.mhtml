_NAME}:${BUILD_NUMBER} ."</span>
                    sh <span class=3D"hljs-string">"docker tag ${IMAGE_NAME=
}:${BUILD_NUMBER} ${IMAGE_NAME}:latest"</span>
                }
            }
        }

        stage(<span class=3D"hljs-string">'Deploy to Staging Container'</sp=
an>) {
            steps {
                sh <span class=3D"hljs-string">'''
